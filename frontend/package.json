{
  "name": "ad-generator-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Build Tailwind (CLI) du front statique. Produit css/app.css versionné.",
  "scripts": {
    "build:css": "tailwindcss -i ./css/input.css -o ./css/app.css --minify",
    "watch:css": "tailwindcss -i ./css/input.css -o ./css/app.css --watch",
    "check:i18n": "node tools/check-i18n.mjs"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "tailwindcss": "^3.4.17"
  }
}
