# Copier en .env et adapter. NE PAS committer .env.

# --- Backend ---
# Secret de signature des sessions (long, aléatoire) :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-long-random-string
PORT=3000

# URL du webhook n8n.
#   - docker-compose : http://n8n:5678/webhook/generate-ads
#   - dev local      : http://localhost:5678/webhook/generate-ads
N8N_WEBHOOK_URL=http://n8n:5678/webhook/generate-ads

# Token partagé backend <-> n8n (protège le webhook). Même valeur des deux côtés.
N8N_TOKEN=change-me-shared-token

# Timeout de l'appel n8n/Gemini (ms).
N8N_TIMEOUT_MS=120000

# Suivi de consommation (aligner avec le modèle utilisé par n8n).
#   gemini-2.5-flash-image ≈ 0.039 ; gemini-3-pro-image ≈ 0.134
COST_PER_IMAGE_USD=0.039
USD_TO_EUR=0.92

# --- Déploiement ---
DOMAIN=localhost

# Comptes pré-créés (login only, pas d'inscription publique).
# Format: email:motdepasse,email2:motdepasse2  (pas de virgule dans un mot de passe)
SEED_USERS=toi@exemple.com:MotDePasseRobuste,daronne@exemple.com:AutreMotDePasse

# La CLÉ API GEMINI ne se met PAS ici : elle se configure comme credential
# "Header Auth" dans n8n (nom d'en-tête : x-goog-api-key).
