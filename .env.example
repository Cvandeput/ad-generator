# Copier en .env et adapter. NE PAS committer .env.
# Le backend REFUSE de démarrer en production si un secret manque ou garde sa
# valeur d'exemple.

# --- Backend ---
# Secret de signature des sessions (≥ 32 caractères) :  openssl rand -hex 48
SESSION_SECRET=
PORT=3000
NODE_ENV=production

# Cookie de session `secure` : true = exige HTTPS (défaut en prod, déduit de
# NODE_ENV). En dev local SANS TLS avec NODE_ENV=production, mettre `false`.
# SESSION_COOKIE_SECURE=false
# Inactivité max (cookie glissant) et durée absolue d'une session.
SESSION_IDLE_HOURS=24
SESSION_ABSOLUTE_DAYS=7

# Origine publique du site, pour la vérification anti-CSRF (Origin/Referer).
# Plusieurs valeurs séparées par des virgules.
APP_ORIGINS=https://ads.devwork.cloud
DOMAIN=ads.devwork.cloud

# URL du webhook n8n.
#   - VPS (n8n sur l'hôte ou autre conteneur) : http://host.docker.internal:5678/webhook/generate-ads
#   - même réseau docker que n8n                : http://n8n:5678/webhook/generate-ads
N8N_WEBHOOK_URL=http://host.docker.internal:5678/webhook/generate-ads
# Token partagé backend <-> n8n (≥ 24 caractères) :  openssl rand -hex 32
# Même valeur dans la variable d'env WEBHOOK_TOKEN de n8n.
N8N_TOKEN=
N8N_TIMEOUT_MS=150000

# --- Inscription ---
#   open   → inscription publique (défaut). Chaque compte démarre sur la formule
#            gratuite ; son quota borne ce qu'il peut coûter.
#   invite → inscription avec REGISTER_INVITE_CODE (≥ 12 caractères)
#   closed → pas d'inscription : comptes = SEED_USERS uniquement
# Comptes administrateur : quota illimité + console /admin.html. Adresses
# séparées par des virgules. Appliqué à chaque démarrage, dans les deux sens
# (retirer une adresse retire le rôle). Se promouvoir demande un accès serveur.
ADMIN_EMAILS=

REGISTER_MODE=open
REGISTER_INVITE_CODE=
# Générations offertes à la création du compte (pour la VIE du compte, pas par
# mois). Mettre 0 pour exiger un abonnement dès l'inscription.
FREE_PLAN_QUOTA=5

# --- Vérification d'e-mail (indispensable si REGISTER_MODE=open) ---
# Sans elle, un robot crée des comptes en série pour cumuler les quotas gratuits.
# Non renseigné = activée dès que SMTP_HOST est défini. Le backend refuse de
# démarrer en production si on la force à true sans SMTP.
# EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_TTL_HOURS=24
# SMTP : le Postfix du VPS (réseau docker mail-shared-network) ou un service
# transactionnel. Sans SMTP_HOST, les liens sont journalisés au lieu d'être
# envoyés (dev uniquement).
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AdCraft <noreply@ads.devwork.cloud>
# Postfix local avec certificat auto-signé : mettre false.
# SMTP_TLS_REJECT_UNAUTHORIZED=false
# Version des mentions légales : changer la valeur force une ré-acceptation.
TERMS_VERSION=2026-09-13

# Comptes pré-créés. Format : email:motdepasse,email2:b64:<hash bcrypt en base64>
# Préférer un HASH bcrypt (pas de mot de passe en clair dans ce fichier), encodé
# en base64 car docker compose interpole les `$` du hash comme des variables :
#   docker compose run --rm backend node -e "const b=require('bcryptjs');console.log('b64:'+Buffer.from(b.hashSync(process.argv[1],12)).toString('base64'))" 'MonMotDePasse'
# Un compte existant n'est jamais écrasé (sauf SEED_FORCE_PASSWORD=true, une fois).
SEED_USERS=toi@exemple.com:b64:JDJhJDEyJHJlbXBsYWNlUGFyVW5IYXNoQmNyeXB0

# --- Quotas de génération, par compte ---
GEN_PER_HOUR=20
GEN_PER_DAY=60

# --- Modèle image (piloté côté n8n, recopié ici pour le coût affiché AVANT génération) ---
#   gemini-3.1-flash-image      0.5K 0.045 $ · 1K 0.067 $ · 2K 0.101 $ · 4K 0.151 $   (défaut)
#   gemini-3-pro-image          1K/2K 0.134 $ · 4K 0.24 $   (fidélité packaging maximale)
#   gemini-2.5-flash-image      0.039 $ — RETIRÉ LE 2 OCTOBRE 2026, ne plus utiliser
# Après génération, le coût enregistré vient du modèle réellement renvoyé par n8n.
GEMINI_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_SIZE=2K
# Forcer un prix (USD/image) au lieu de la grille interne. Laisser vide.
# COST_PER_IMAGE_USD=
USD_TO_EUR=0.92

# La CLÉ API GEMINI ne se met PAS ici : n8n utilise une credential Google
# Service Account. GEMINI_API_KEY ne sert qu'à tools/test-gemini.mjs en local.
# GEMINI_API_KEY=

# --- Facturation (prototype) ---
# false (défaut) : aucune route /api/billing, aucun quota d'abonnement, le
# comportement est exactement celui d'avant. true : active la page /tarifs.html.
BILLING_ENABLED=false
# Sans STRIPE_SECRET_KEY, la facturation tourne en MODE DÉMO : les abonnements
# sont simulés en base (pour tester les quotas), rien n'est facturé.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_PACK20=
